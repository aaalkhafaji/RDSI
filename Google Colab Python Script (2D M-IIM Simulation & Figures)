    fig.savefig(filepath, dpi=300, bbox_inches='tight')
    plt.close(fig)

# 1. SFD Spatial Signal (2D Leakage)
fig1, ax1 = plt.subplots(figsize=(5, 4))
im1 = ax1.imshow(U_sfd[:, :, 0, 0], extent=[-1, 1, -1, 1], cmap='coolwarm', origin='lower')
ax1.set_title("SFD: Numerical Leakage in 2D", fontsize=11, fontweight='bold')
fig1.colorbar(im1, ax=ax1)
save_fig(fig1, "Fig1_SFD_2D_Leakage.png")

# 2. M-IIM Spatial Signal (2D Zero Leakage)
fig2, ax2 = plt.subplots(figsize=(5, 4))
im2 = ax2.imshow(U_miim[:, :, 0, 0], extent=[-1, 1, -1, 1], cmap='coolwarm', origin='lower')
ax2.set_title("M-IIM: Exact 2D Absolute Sink", fontsize=11, fontweight='bold')
fig2.colorbar(im2, ax=ax2)
save_fig(fig2, "Fig2_MIIM_2D_Zero_Leakage.png")

# 3. Logarithmic Error Norm Comparison
fig3, ax3 = plt.subplots(figsize=(5, 4))
im3 = ax3.imshow(np.log10(error_sfd + 1e-16), extent=[-0.5, 0.5, -0.5, 0.5], cmap='inferno', origin='lower')
ax3.set_title("SFD Log10 Error Inside Enclave", fontsize=11, fontweight='bold')
fig3.colorbar(im3, ax=ax3)
save_fig(fig3, "Fig3_SFD_Log_Error.png")

# 4. 3D Surface - SFD Boundary Corrosion
fig4 = plt.figure(figsize=(6, 5))
ax4 = fig4.add_subplot(111, projection='3d')
ax4.plot_surface(X, Y, U_sfd[:, :, 0, 0], cmap='coolwarm', alpha=0.85, rstride=2, cstride=2)
ax4.set_title("3D Surface: SFD Boundary Smearing", fontsize=11, fontweight='bold')
ax4.view_init(elev=30, azim=45)
save_fig(fig4, "Fig4_3D_SFD_Smearing.png")

# 5. 3D Surface - M-IIM Smooth Enclave Preservation
fig5 = plt.figure(figsize=(6, 5))
ax5 = fig5.add_subplot(111, projection='3d')
ax5.plot_surface(X, Y, U_miim[:, :, 0, 0], cmap='coolwarm', alpha=0.85, rstride=2, cstride=2)
ax5.set_title("3D Surface: M-IIM Smooth Core", fontsize=11, fontweight='bold')
ax5.view_init(elev=30, azim=45)
save_fig(fig5, "Fig5_3D_MIIM_Core.png")

# 6. Machine Precision Flatline Proof
fig6, ax6 = plt.subplots(figsize=(6, 4))
center_slice_sfd = error_sfd[N//2, N//4:3*N//4]
center_slice_miim = error_miim[N//2, N//4:3*N//4]
x_slice = x[N//4:3*N//4]
ax6.semilogy(x_slice, center_slice_sfd, 'r--', label='SFD Leakage (~10^-2)')
ax6.semilogy(x_slice, center_slice_miim + 1e-16, 'g-', lw=2, label='M-IIM Limit (<10^-15)')
ax6.set_title("Cross-Section Error Norm L(δ)", fontsize=11, fontweight='bold')
ax6.set_xlabel("Spatial Axis x")
ax6.set_ylabel("Frobenius Error Norm")
ax6.grid(True, which="both", ls=":", alpha=0.6)
ax6.legend(loc="upper right")
save_fig(fig6, "Fig6_Error_Cross_Section.png")

